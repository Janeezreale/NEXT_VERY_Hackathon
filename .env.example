# Public, browser-safe Supabase project configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server only — NEVER use NEXT_PUBLIC_ for this key
OPENAI_API_KEY=YOUR_SERVER_SIDE_OPENAI_API_KEY
# Set after verifying image input and structured output support.
OPENAI_VISION_MODEL=

# NAVER Cloud Maps. The key ID is public; register Web service URLs in the console.
NEXT_PUBLIC_NAVER_MAPS_CLIENT_ID=YOUR_NAVER_MAPS_CLIENT_ID
# Server only — used for Geocoding. NEVER use NEXT_PUBLIC_ for this key
NAVER_MAPS_CLIENT_SECRET=YOUR_NAVER_MAPS_CLIENT_SECRET

# Proposed time policy: UTC storage / Asia/Seoul display; confirm docs/DECISIONS.md D02.
# Region names, prices, product listings and booking figures MUST come from the DB.
